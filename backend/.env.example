# ---- Claude API ----
ANTHROPIC_API_KEY=sk-ant-...
# scripts/upload_skill.py 실행 후 출력되는 skill_01... 값
DFC_SKILL_ID=skill_01xxxxxxxxxxxxxxxxxxxxxx
# 운영에서는 latest 대신 skver_... 로 고정 권장
DFC_SKILL_VERSION=latest
# 정확도 우선 opus, 비용 우선 sonnet
CLAUDE_MODEL=claude-opus-5
MAX_TOKENS=32000
WEB_SEARCH_MAX_USES=15
WEB_FETCH_MAX_USES=10
PAUSE_TURN_MAX_ROUNDS=12

# ---- 국가법령정보센터 오픈API (open.law.go.kr 에서 신청한 이메일 아이디). 비우면 법령 도구 미사용 ----
LAW_API_OC=
LAW_TOOL_MAX_CALLS=30

# ---- 인증·조직 ----
# 0: 초대 코드로만 가입(내부용 권장) / 1: 누구나 새 조직을 만들어 가입(고객 셀프 온보딩)
ALLOW_SELF_SIGNUP=0
DEFAULT_MONTHLY_JOB_LIMIT=100

# ---- 앱 ----
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
DATA_DIR=./data
MAX_UPLOAD_MB=20
MAX_CONCURRENT_JOBS=2
# 1이면 API를 호출하지 않고 샘플 결과를 반환 (프론트 개발용)
MOCK_VERIFIER=0
