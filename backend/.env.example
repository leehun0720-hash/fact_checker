# ---- Claude API ----
ANTHROPIC_API_KEY=sk-ant-...
# scripts/upload_skill.py 실행 후 출력되는 skill_01... 값
DFC_SKILL_ID=skill_01xxxxxxxxxxxxxxxxxxxxxx
# 운영에서는 latest 대신 skver_... 로 고정 권장
DFC_SKILL_VERSION=latest
# 정확도 우선 claude-opus-5 ($5/$25 per MTok), 비용 우선 claude-sonnet-5 ($2/$10)
CLAUDE_MODEL=claude-opus-5
MAX_TOKENS=32000
# ---- 비용 조절 ----
# 프롬프트 캐시: 라운드마다 다시 보내는 앞부분을 정가의 10%로. 끌 이유가 없다.
PROMPT_CACHE=1
# 추론 깊이 low|medium|high|xhigh|max. 조사형 작업은 medium이 high와 정확도 동급, 비용 70~85%.
EFFORT=medium
# 웹 검색 회당 $0.01 + 결과가 문맥에 남아 이후 라운드마다 재과금. fetch는 토큰 비용만.
WEB_SEARCH_MAX_USES=8
WEB_FETCH_MAX_USES=5
WEB_FETCH_MAX_CONTENT_TOKENS=10000
PAUSE_TURN_MAX_ROUNDS=12

# ---- 국가법령정보센터 오픈API (open.law.go.kr 에서 신청한 이메일 아이디). 비우면 법령 도구 미사용 ----
LAW_API_OC=
LAW_TOOL_MAX_CALLS=30

# ---- 인증·조직 ----
# 0: 초대 코드로만 가입(내부용 권장) / 1: 누구나 새 조직을 만들어 가입(고객 셀프 온보딩)
ALLOW_SELF_SIGNUP=0
DEFAULT_MONTHLY_JOB_LIMIT=100

# ---- 앱 ----
CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app
DATA_DIR=./data
MAX_UPLOAD_MB=20
MAX_CONCURRENT_JOBS=2
# 1이면 API를 호출하지 않고 샘플 결과를 반환 (프론트 개발용)
MOCK_VERIFIER=0
